__pycache__/
*.pyo
.venv/
venv/
.env

*.zip

# runtime output
work/reports/*
work/builds/*
work/loot/
work/dox/
!work/reports/.gitkeep
!work/builds/.gitkeep

# local settings — never pushed
settings.json
pack.json
backups/

# paid extension pack modules — free versions of these files are tracked,
# so this only blocks the *untracked* paid-only module. Reinstalling the
# pack materialises it in the tree; this keeps it out of git.
tools_builder.py

# compiled copy — rebuild with build_protected.py
dist/

# relay secrets — never commit
relay-keys.env
relay-users.json
*.relay.tokens