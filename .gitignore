__pycache__/
*.pyo
.venv/
venv/
.env

*.zip

# runtime output
reports/*
builds/*
loot/*
dox/*
!reports/.gitkeep
!builds/.gitkeep
!loot/.gitkeep
!dox/.gitkeep

# local settings
settings.json
pack.json
backups/

# paid extension pack modules — free versions of these files are tracked,
# so this only blocks the *untracked* paid-only module. Reinstalling the
# pack materialises it in the tree; this keeps it out of git.
tools_builder.py

# compiled copy — rebuild with build_protected.py
dist/

# relay secrets — never commit
relay-keys.env
relay-users.json
*.relay.tokens

# work/ is the permanent sync folder — always tracked, never ignored
!work/
!work/**
