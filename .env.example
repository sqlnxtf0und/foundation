# nxtf0und — external API keys.
# Copy this file to .env and fill in the services you use.
# .env is git-ignored. Exported environment variables override these values.
# Manage them from the running tool: Settings -> 9 (api keys).

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# urlscan.io — https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# Censys (both values are required) — https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# IPinfo — https://ipinfo.io/account/token
IPINFO_TOKEN=

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api
OTX_API_KEY=

# GreyNoise — https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# Shodan (paid) — https://account.shodan.io/
SHODAN_API_KEY=

# Have I Been Pwned (breach search is a paid subscription)
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# EmailRep — https://emailrep.io/key
EMAILREP_API_KEY=

# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=

# SecurityTrails — https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=
